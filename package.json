{
  "name": "google-tasks-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets AI agents manage Google Tasks.",
  "type": "module",
  "bin": {
    "google-tasks-mcp": "dist/index.js",
    "google-tasks-mcp-auth": "dist/auth.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "auth": "tsx src/auth.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "google-tasks",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "googleapis": "^176.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
